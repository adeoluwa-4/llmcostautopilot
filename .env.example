# Autopilot API settings
PORT=8787
# AUTOPILOT_API_KEY=replace-with-a-client-facing-key

# Optional OpenAI-compatible upstream. When omitted, the local mock provider is used.
# For Vercel AI Gateway, use its OpenAI-compatible base URL and an AI Gateway key.
# AUTOPILOT_UPSTREAM_BASE_URL=https://your-gateway.example/v1
# AUTOPILOT_UPSTREAM_API_KEY=replace-with-an-upstream-key
# AUTOPILOT_UPSTREAM_TIMEOUT_MS=30000

# Map Autopilot tiers to model IDs supported by the configured upstream.
# AUTOPILOT_ECONOMY_MODEL=provider/economy-model
# AUTOPILOT_BALANCED_MODEL=provider/balanced-model
# AUTOPILOT_PREMIUM_MODEL=provider/premium-model

# Optional JSON registry override. Prices are USD per one million tokens.
# AUTOPILOT_MODELS_JSON=[{"id":"economy","providerModelId":"provider/model","tier":"economy","quality":0.62,"inputPrice":0.1,"outputPrice":0.4,"contextLimit":32000,"maxOutputTokens":4096,"capabilities":["text","json_schema","tools"]}]
